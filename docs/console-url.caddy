# Import inside the existing wildcard HTTPS site, before its general reverse_proxy.
# Keep Coder's owner-only app authentication in the request path.
@consoleLegacy host 7070--{$CODER_WORKSPACE_HOST_SUFFIX}
redir @consoleLegacy https://console.nefro-dev-coder.duckdns.org{uri} 307

@consoleAlias host console.nefro-dev-coder.duckdns.org
handle @consoleAlias {
    @consoleOrigin header Origin https://console.nefro-dev-coder.duckdns.org
    request_header @consoleOrigin Origin https://7070--{$CODER_WORKSPACE_HOST_SUFFIX}
    reverse_proxy 127.0.0.1:7080 {
        header_up Host 7070--{$CODER_WORKSPACE_HOST_SUFFIX}
        header_up X-Agent-Console-Proxy {env.CONSOLE_PROXY_SECRET}
        header_up X-Forwarded-Host 7070--{$CODER_WORKSPACE_HOST_SUFFIX}
    }
}
