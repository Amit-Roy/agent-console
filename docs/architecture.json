{
  "title": "Console auth flow and release deploy",
  "subtitle": "Caddy to agent-console authorization; source tree to immutable release to standby handoff",
  "items": [
    {
      "group": "Edge",
      "icon": "globe",
      "border": "solid",
      "items": [
        {
          "id": "caddy",
          "label": "Reverse proxy",
          "tech": "Caddy",
          "desc": "Fronts the console on the Coder app host",
          "icon": "network",
          "color": "indigo"
        }
      ]
    },
    {
      "group": "agent-console server",
      "icon": "server",
      "border": "dashed",
      "items": [
        {
          "id": "gate",
          "label": "Coder-host trust (fail closed)",
          "tech": "server/auth.ts, x-agent-console-proxy",
          "desc": "SSO needs valid proxy proof; unset secret disables SSO",
          "icon": "shield-check",
          "color": "blue"
        },
        {
          "id": "login",
          "label": "POST /login",
          "tech": "server/index.ts",
          "desc": "Password login; requires same Origin",
          "icon": "log-in",
          "color": "blue"
        },
        {
          "id": "origin",
          "label": "Same-Origin guard",
          "tech": "sameOrigin middleware",
          "desc": "Rejects POST /login without matching Origin (403)",
          "icon": "shield-alert",
          "color": "blue"
        },
        {
          "id": "session",
          "label": "Session cookie",
          "tech": "__Host-ac_session, 30d",
          "desc": "Signed cookie; Secure, host-only, path /",
          "icon": "cookie",
          "color": "teal"
        },
        {
          "id": "acode",
          "label": "Acode edit sessions",
          "tech": "server/acode-core.ts",
          "desc": "Edit grants expire after 12h",
          "icon": "file-pen",
          "color": "purple"
        }
      ]
    },
    {
      "group": "Build source",
      "icon": "git-branch",
      "border": "solid",
      "items": [
        {
          "id": "source",
          "label": "Source git tree",
          "tech": "~/repos/agent-console (main)",
          "desc": "Build source only; never served directly",
          "icon": "folder-git-2",
          "color": "slate"
        },
        {
          "id": "builder",
          "label": "Release builder",
          "tech": "scripts/release.mjs",
          "desc": "Idempotent; git archive, bundle, smoke boot",
          "icon": "package",
          "color": "blue",
          "step": 1
        }
      ]
    },
    {
      "group": "Release store",
      "sub": "~/.local/share/agent-console",
      "icon": "hard-drive",
      "border": "solid",
      "items": [
        {
          "id": "deps",
          "label": "Dependency store",
          "tech": "deps/<lockhash>",
          "desc": "One npm ci per lockfile, hardlinked into releases",
          "icon": "archive",
          "color": "teal"
        },
        {
          "id": "release",
          "label": "Immutable release",
          "tech": "releases/<sha>/",
          "desc": "Prebuilt bundle, read-only, .ready after smoke boot",
          "icon": "package-check",
          "color": "indigo"
        },
        {
          "id": "links",
          "label": "Release pointers",
          "tech": "current / previous symlinks",
          "desc": "Atomic switch; previous kept for rollback",
          "icon": "link",
          "color": "purple"
        }
      ]
    },
    {
      "group": "Supervisor and servers",
      "sub": "bin/agent-console, scripts/idle-restart.mjs",
      "icon": "server",
      "border": "dashed",
      "items": [
        {
          "id": "supervisor",
          "label": "Supervisor",
          "tech": "bin/agent-console supervise",
          "desc": "Starts the standby of the new release, owns the port handoff",
          "icon": "cpu",
          "color": "blue",
          "step": 3
        },
        {
          "id": "standby",
          "label": "Standby server (S2)",
          "tech": "server standby gate",
          "desc": "Boots and binds first; serves nothing until go",
          "icon": "power",
          "color": "teal",
          "step": 4
        },
        {
          "id": "old",
          "label": "Live server (S1)",
          "tech": "previous release",
          "desc": "Fast shutdown on handoff, then S2 takes the port",
          "icon": "server",
          "color": "slate",
          "step": 5
        }
      ]
    },
    {
      "group": "Host resource diagnostics",
      "icon": "activity",
      "border": "solid",
      "items": [
        {
          "id": "host-page",
          "label": "Host dashboard",
          "tech": "public/host.js",
          "desc": "Existing full-page host diagnostics",
          "icon": "activity",
          "color": "blue"
        },
        {
          "id": "host-card",
          "label": "Local /host card",
          "tech": "public/app.js, host-card.js",
          "desc": "CPU, RAM and Disk tabs; static five-minute graph and top three processes; no agent turn",
          "icon": "panels-top-left",
          "color": "blue"
        },
        {
          "id": "host-api",
          "label": "Host snapshot API",
          "tech": "server/host.ts",
          "desc": "Current metrics and all-process CPU, RAM and disk I/O rankings",
          "icon": "cpu",
          "color": "teal"
        },
        {
          "id": "host-telemetry",
          "label": "Host telemetry store",
          "tech": "server/host-history.ts",
          "desc": "Five-second samples; CPU/RAM usage and disk I/O history",
          "icon": "database",
          "color": "purple"
        }
      ]
    },
    {
      "group": "CI test gate",
      "icon": "flask-conical",
      "border": "dashed",
      "items": [
        {
          "id": "order",
          "label": "Measured file weights",
          "tech": "test/weights.json, scripts/test-weights.mjs",
          "desc": "Median seconds per file from recent CI runs",
          "icon": "scale",
          "color": "amber"
        },
        {
          "id": "planner",
          "label": "Longest-first shard plan",
          "tech": "test/shard-plan.mjs",
          "desc": "Heaviest file goes to the least-loaded shard",
          "icon": "split",
          "color": "amber"
        },
        {
          "id": "suites",
          "label": "Heavy browser suites",
          "tech": "drafts-ui, idle-compaction-ui, attachment-drafts-ui",
          "desc": "2 lanes each; attachment capped by AC_ATTACH_LANES",
          "icon": "app-window",
          "color": "amber"
        },
        {
          "id": "shards",
          "label": "3 test runners",
          "tech": "ubuntu-latest, 4 vCPU, 8 files at once",
          "desc": "About 75 s summed per shard",
          "icon": "cpu",
          "color": "amber"
        },
        {
          "id": "budget",
          "label": "Shard budget gate",
          "tech": "test/shard-budget.mjs, SHARD_COUNT",
          "desc": "15 s per file, 25 s whole run",
          "icon": "gauge",
          "color": "amber"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "caddy",
      "to": "gate",
      "label": "Coder-host requests"
    },
    {
      "from": "login",
      "to": "session",
      "label": "sets cookie"
    },
    {
      "from": "gate",
      "to": "acode",
      "label": "authorizes grants"
    },
    {
      "from": "origin",
      "to": "login",
      "label": "guards POST"
    },
    {
      "from": "source",
      "to": "builder",
      "label": "git archive <sha>",
      "step": 1
    },
    {
      "from": "builder",
      "to": "deps",
      "label": "build or reuse"
    },
    {
      "from": "deps",
      "to": "release",
      "label": "hardlink"
    },
    {
      "from": "builder",
      "to": "release",
      "label": "bundle + smoke boot",
      "step": 2
    },
    {
      "from": "release",
      "to": "links",
      "label": "flip on ready"
    },
    {
      "from": "links",
      "to": "supervisor",
      "label": "idle restart picks new release",
      "step": 3
    },
    {
      "from": "supervisor",
      "to": "standby",
      "label": "spawn from release",
      "step": 4
    },
    {
      "from": "supervisor",
      "to": "old",
      "label": "stop, then go",
      "step": 5
    },
    {
      "from": "host-card",
      "to": "host-api",
      "label": "Snapshot"
    },
    {
      "from": "host-card",
      "to": "host-telemetry",
      "label": "300s history"
    },
    {
      "from": "host-page",
      "to": "host-api",
      "label": "Metrics"
    },
    {
      "from": "host-page",
      "to": "host-telemetry",
      "label": "History"
    },
    {
      "from": "order",
      "to": "planner",
      "label": "weights"
    },
    {
      "from": "planner",
      "to": "shards",
      "label": "file lists"
    },
    {
      "from": "suites",
      "to": "shards",
      "label": "run in"
    },
    {
      "from": "shards",
      "to": "budget",
      "label": "test logs"
    },
    {
      "from": "budget",
      "to": "release",
      "label": "gates deploy"
    }
  ]
}
