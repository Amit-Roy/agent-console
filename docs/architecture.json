          "icon": "archive",
          "status": "modified",
          "step": 1
        },
        {
          "id": "questions",
          "label": "Question registry",
          "tech": "server/threads.ts",
          "desc": "Pending requests per thread, blocking or async",
          "icon": "list-checks"
        },
        {
          "id": "note-q",
          "label": "noteQuestion",
          "tech": "server/threads.ts",
          "desc": "A new question unarchives the thread so the user sees it",
          "icon": "message-circle-question",
          "status": "modified",
          "step": 2
        }
      ]
    },
    {
      "group": "Watchdog",
      "icon": "shield-check",
      "items": [
        {
          "id": "sweep",
          "label": "sweepRunning",
          "tech": "server/threads.ts",
          "desc": "Ends a turn silent for 30 min unless waitingOnUser",
