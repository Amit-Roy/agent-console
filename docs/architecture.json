{
  "title": "Opener thread lifecycle, archive pending input, dashboard savings and Vault iron providers",
  "subtitle": "RTK command-output savings and Headroom input savings have separate scopes",
  "items": [
    {
      "group": "Local savings sources",
      "icon": "database",
      "items": [
        {
          "id": "rtk",
          "label": "RTK command history",
          "tech": "rtk gain -f json --daily",
          "desc": "Recorded command-output reductions",
          "icon": "terminal"
        },
        {
          "id": "history",
          "label": "Headroom savings ledger",
          "tech": "GET /stats-history",
          "desc": "Durable daily input-reduction history",
          "icon": "database"
        }
      ]
    },
    {
      "group": "Console collectors",
      "icon": "server",
      "items": [
        {
          "id": "rtk-collector",
          "label": "RTK collector",
          "tech": "analytics.ts",
          "desc": "Share pending collection; cache successful results for 60 seconds",
          "icon": "terminal"
        },
        {
          "id": "history-collector",
          "label": "History collector",
          "tech": "headroom.ts",
          "desc": "Independent of routing; eight-second timeout; share pending collection",
          "icon": "activity"
        },
        {
          "id": "api",
          "label": "Dashboard API",
          "tech": "GET /api/dashboard",
          "desc": "Unavailable history is null; measured empty history is an empty array",
          "icon": "route"
        }
      ]
    },
    {
      "group": "Usage dashboard",
      "icon": "chart-column",
      "items": [
        {
          "id": "view",
          "label": "Savings display",
          "tech": "dashboard.js",
          "desc": "Unavailable measurements show an em dash; measured zero stays zero",
          "icon": "chart-column"
        }
      ]
    },
    {
      "group": "Vault secrets path",
      "icon": "key-round",
      "color": "indigo",
      "border": "solid",
      "status": "added",
      "items": [
        {
          "id": "vault-ui",
          "label": "Vault UI",
          "tech": "public/vault.js",
          "desc": "Replace/Add key opens the step dialog; reload mid-job restores it from the ironJob snapshot",
          "icon": "layout-dashboard",
          "color": "indigo",
          "status": "modified",
          "step": 1
        },
        {
          "id": "vault",
          "label": "Vault guard",
          "tech": "server/vault.ts",
          "desc": "Validates the spec, streams save steps as NDJSON (Accept: application/x-ndjson), JSON otherwise; 502 if iron down",
          "icon": "shield-check",
          "color": "indigo",
          "status": "modified",
          "step": 2
        },
        {
          "id": "iron-client",
          "label": "Iron client",
          "tech": "server/vault-iron.ts",
          "desc": "Own SSH key, no multiplexing; status / set / token / provider-add / ca-pem",
          "icon": "terminal",
          "color": "slate",
          "status": "modified",
          "step": 3
        },
        {
          "id": "backup",
          "label": "Backup job",
          "tech": "server/vault-backup.ts",
          "desc": "30 s debounce, detached iron backup, status file, retry API",
          "icon": "database-backup",
          "color": "teal",
          "status": "added"
        },
        {
          "id": "egress",
          "label": "Egress refresh",
          "tech": "server/vault-egress.ts",
          "desc": "Trust iron CA, append new hosts, run egress-pin",
          "icon": "shield",
          "color": "teal",
          "status": "added",
          "step": 5
        },
        {
          "id": "save-job",
          "label": "Vault save job",
          "tech": "server/vault-save-job.ts",
          "desc": "One job: set, check, backup, drive; resumable Retry; ironJob snapshot",
          "icon": "list-checks",
          "color": "indigo",
          "status": "added"
        },
        {
          "id": "doctor",
          "label": "Vault doctor",
          "tech": "server/vault-doctor.ts",
          "desc": "Runs iron doctor for one provider, maps check lines to step results",
          "icon": "stethoscope",
          "color": "teal",
          "status": "added"
        },
        {
          "id": "timeline",
          "label": "Step timeline",
          "tech": "public/step-timeline.js, vault-steps.js",
          "desc": "Live steps with durations, error text, Retry and Done buttons",
          "icon": "list-todo",
          "color": "indigo",
          "status": "added"
        }
      ]
    },
