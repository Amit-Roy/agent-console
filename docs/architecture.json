        },
        {
          "id": "idle",
          "label": "Idle restart",
          "tech": "scripts/idle-restart.mjs",
          "desc": "Counts running threads before deploy; hung archived turns no longer block it",
          "icon": "rotate-cw"
        }
      ]
    },
    {
      "group": "Opener thread lifecycle",
      "icon": "app-window",
      "items": [
        {
          "id": "opener",
          "label": "Window opener",
          "tech": "server/index.ts",
