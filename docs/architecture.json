          "icon": "hourglass",
          "status": "added",
          "step": 4
        }
      ]
    },
    {
      "group": "Visible state",
      "icon": "layout-dashboard",
      "items": [
        {
          "id": "lane",
          "label": "Threads lane dot",
          "tech": "public/app.js",
          "desc": "Pulses only while a visible thread is waiting or running",
