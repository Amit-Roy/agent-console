          "status": "modified",
          "step": 1
        },
        {
          "id": "remove",
          "label": "removeDisposable",
          "tech": "server/threads.ts",
          "desc": "Deletes it next tick after the turn result or on hung-turn expire",
          "icon": "trash-2",
          "status": "added",
          "step": 2
        },
        {
          "id": "purge",
          "label": "purgeDisposable",
          "tech": "server/threads.ts",
          "desc": "At boot removes idle disposable threads and legacy archived Window opener threads",
          "icon": "broom",
          "status": "added",
          "step": 3
        },
        {
          "id": "hide",
          "label": "visibleThreadList",
          "tech": "public/app.js",
          "desc": "Hides disposable threads from the list",
          "icon": "eye-off",
          "status": "modified",
          "step": 4
        }
      ]
