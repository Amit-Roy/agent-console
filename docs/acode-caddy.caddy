# Inside the existing wildcard HTTPS site, before reverse_proxy.
# Coder v2.38's default template CORS policy strips application CORS headers.
# Scope this exception to the capability-only bridge host and API paths.
@acodeWebView {
    host 7076--main--workspace--example-owner.coder.example.com
    path /api/acode/exchange /api/acode/file /api/acode/tree /api/acode/open
    header_regexp Origin "^(null|file://|https://localhost|http://localhost(:8080)?)$"
}
header @acodeWebView {
    Access-Control-Allow-Origin {http.request.header.Origin}
    Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS"
    Access-Control-Allow-Headers "Authorization, Content-Type"
    +Vary Origin
    defer
}
@acodePreflight {
    host 7076--main--workspace--example-owner.coder.example.com
    path /api/acode/exchange /api/acode/file /api/acode/tree /api/acode/open
    header_regexp Origin "^(null|file://|https://localhost|http://localhost(:8080)?)$"
    method OPTIONS
}
respond @acodePreflight "" 204
