# Deployment identifiers. Real values live in ~/.config/agent-console/env (gitignored); process env wins.
# Expected Claude sign-in emails (unset skips the mismatch check and `--email` on login)
CLAUDE_SUNNY_EMAIL=sunny@example.com
CLAUDE_NEFRO_EMAIL=nefro@example.com
# Default vault alert recipients, comma lists
AGENT_CONSOLE_ALERT_TO=alerts@example.com
AGENT_CONSOLE_ALERT_CC=copy@example.com
# Coder workspace identity, also set in /etc/caddy/console-proxy.env on the VPS
CODER_USER=owner
CODER_WORKSPACE_HOST_SUFFIX=main--workspace--owner.example.test
CODER_CONTAINER=coder-Owner-workspace
# Laptop SSH user
LAPTOP_USER=user
