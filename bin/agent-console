#!/usr/bin/env bash
# agent-console start|stop|restart|restart-when-idle|status|password|url
set -u
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
RUN="${AGENT_CONSOLE_RUN:-$HOME/.cache/agent-console}"; mkdir -p "$RUN"; export AGENT_CONSOLE_RUN="$RUN"; PORT="${PORT:-7070}"
export PATH="$HOME/.local/bin:$PATH"
running() { [ -f "$RUN/pid" ] && kill -0 "$(cat "$RUN/pid")" 2>/dev/null; }
case "${1:-status}" in
  start) running && { echo "already running"; exit 0; }
         (cd "$DIR" && PORT=$PORT AGENT_CONSOLE_PID_FILE="$RUN/pid" exec nohup node server/index.ts >"$RUN/log" 2>&1) & sleep 1.5; "$0" status; "$0" url ;;
  stop)  running && kill "$(cat "$RUN/pid")" && echo stopped || echo "not running" ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  # for agents: run as the last step of a turn that changed the server. Returns at once; a detached watcher waits for every running
  # thread (including the caller's) to finish, then restarts the server. Open browsers reload themselves.
  restart-when-idle) (cd "$DIR" && setsid nohup node scripts/idle-restart.mjs </dev/null >>"$RUN/idle-restart.log" 2>&1 &); echo "restart scheduled: it happens when no thread is running (log: $RUN/idle-restart.log)" ;;
  status) running && echo "up (pid $(cat "$RUN/pid"))" || echo down ;;
  password) cat "$HOME/.config/agent-console/password" 2>/dev/null || echo "(created on first start)" ;;
  url) echo "$(echo "${VSCODE_PROXY_URI:-}" | sed "s/{{port}}/$PORT/")" ;;
esac
