#!/usr/bin/env bash
# agent-console start|stop|restart|restart-when-idle|status|password|url  (supervise: internal, run by start)
set -u
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
RUN="${AGENT_CONSOLE_RUN:-$HOME/.cache/agent-console}"; mkdir -p "$RUN"; export AGENT_CONSOLE_RUN="$RUN"; PORT="${PORT:-7070}"
export PATH="$HOME/.local/bin:$PATH"
# PMG (SafeDep) shims go first so every agent's npm/pip/uv/bun install is checked for known malware before it runs.
PMG_SHIMS="$HOME/.local/share/safedep/pmg/bin"; [ -x "$PMG_SHIMS/npm" ] && export PATH="$PMG_SHIMS:$PATH"
# A restart issued from a Nefro thread inherits its profile; Sunny must keep the default Claude login.
[ "${CLAUDE_CONFIG_DIR:-}" = "$HOME/.claude-nefro" ] && unset CLAUDE_CONFIG_DIR
# Coder exec sessions export the account email as GIT_AUTHOR_*/GIT_COMMITTER_*; it overrides ~/.gitconfig
# (noreply address) for every agent commit, and GitHub email privacy then rejects the push.
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
# the pid file survives a workspace restart, when its pid may belong to an unrelated process: check it is our server
running() { [ -f "$RUN/pid" ] && grep -qa "server/index.ts" "/proc/$(cat "$RUN/pid")/cmdline" 2>/dev/null; }
# the supervisor restarts the server whenever it exits, unless `stop` killed the supervisor first
supervised() { [ -f "$RUN/supervisor" ] && tr '\0' ' ' <"/proc/$(cat "$RUN/supervisor")/cmdline" 2>/dev/null | grep -q "bin/agent-console supervise"; }
case "${1:-status}" in
  start) if [ "$RUN" = "$HOME/.cache/agent-console" ] && [ "${AGENT_CONSOLE_MOCK:-0}" != "1" ]; then
           # its own Node boot takes seconds even when it is already up; the server only polls its database, so never wait for it
           ( "$DIR/bin/github-triage" start || echo "[$(date +%Y-%m-%dT%H:%M:%S.%3N%:z)] GitHub triage could not start; see its private log." ) </dev/null >>"$RUN/log" 2>&1 &
         fi
         running && { echo "already running"; exit 0; }
         supervised && { echo "already running (supervisor $(cat "$RUN/supervisor") is restarting the server; see $RUN/log)"; exit 0; }
         # a server we lost track of (pid file gone) still holds the port: adopt it instead of crashing on EADDRINUSE
         pid=$(ss -ltnpH "sport = :$PORT" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
         [ -n "$pid" ] && grep -qa "server/index.ts" "/proc/$pid/cmdline" 2>/dev/null && { echo "$pid" >"$RUN/pid"; echo "already running (pid $pid)"; exit 0; }
         PORT=$PORT setsid nohup "$DIR/bin/agent-console" supervise </dev/null >/dev/null 2>&1 &
         for _ in $(seq 100); do running && break; sleep 0.2; done; "$0" status; "$0" url ;;
  supervise) # A PID file alone cannot serialize concurrent start or restart requests.
         exec 8>"$RUN/supervisor.lock"
         flock -n 8 || exit 0
         echo $$ >"$RUN/supervisor"; delay=1
         while :; do
           # append, so the reason the last server died survives the restart; rotate at 5 MB
           [ "$(stat -c %s "$RUN/log" 2>/dev/null || echo 0)" -gt 5000000 ] && mv "$RUN/log" "$RUN/log.1"
           # one bundled module loads in a fraction of the time of ~150 source modules; rebuild it when any source is newer.
           # While the server keeps crashing on boot (delay > 1), run the sources directly in case the bundle is at fault.
           entry=server/index.ts bundle=.bundle/server/index.ts.mjs
           if [ "$delay" -le 1 ] && [ -f "$DIR/scripts/bundle-server.mjs" ]; then
             if [ ! -f "$DIR/$bundle" ] || [ -n "$(cd "$DIR" && find server scripts/bundle-server.mjs package-lock.json -newer "$bundle" -print -quit)" ]; then
               (cd "$DIR" && node scripts/bundle-server.mjs) >>"$RUN/log" 2>&1 || echo "[$(date +%Y-%m-%dT%H:%M:%S.%3N%:z)] supervisor $$: bundle failed; running sources" >>"$RUN/log"
             fi
             [ -f "$DIR/$bundle" ] && [ -z "$(cd "$DIR" && find server scripts/bundle-server.mjs package-lock.json -newer "$bundle" -print -quit)" ] && entry=$bundle
           fi
           # the compile cache keeps Node from re-stripping TypeScript and recompiling every module on each boot
           echo "[$(date +%Y-%m-%dT%H:%M:%S.%3N%:z)] supervisor $$: starting server ($entry)" >>"$RUN/log"; began=$(date +%s)
           (cd "$DIR" && PORT=$PORT AGENT_CONSOLE_PID_FILE="$RUN/pid" NODE_COMPILE_CACHE="$RUN/compile-cache" exec node "$entry" 8>&-) >>"$RUN/log" 2>&1; code=$?
           [ $(($(date +%s) - began)) -ge 60 ] && delay=1 # back off only while it keeps crashing on boot
           echo "[$(date +%Y-%m-%dT%H:%M:%S.%3N%:z)] supervisor $$: server exited with code $code; restarting in ${delay}s" >>"$RUN/log"
           sleep "$delay"; delay=$((delay < 30 ? delay * 2 : 30))
         done ;;
  stop)  supervised && kill "$(cat "$RUN/supervisor")"; rm -f "$RUN/supervisor"
         running && kill "$(cat "$RUN/pid")" && echo stopped || echo "not running" ;;
  restart) old=$(cat "$RUN/pid" 2>/dev/null); "$0" stop
           # the old server holds the port until it exits; wait for exactly that instead of a fixed second
           [ -n "$old" ] && timeout 10 tail --pid="$old" -f /dev/null 2>/dev/null; "$0" start ;;
  # for agents: run as the last step of a turn that changed the server. Returns at once; a detached watcher waits for every running
  # thread (including the caller's) to finish, then restarts the server. Open browsers reload themselves.
  # redirect the whole subshell: a forked list left holding the caller's stdout makes `... | tail` wait for the restart
  restart-when-idle) (cd "$DIR" && exec setsid nohup flock --close -n "$RUN/idle-restart.lock" node scripts/idle-restart.mjs) </dev/null >>"$RUN/idle-restart.log" 2>&1 & echo "restart scheduled: it happens when no thread is running (log: $RUN/idle-restart.log)" ;;
  status) running && echo "up (pid $(cat "$RUN/pid"))" || echo down ;;
  password) cat "$HOME/.config/agent-console/password" 2>/dev/null || echo "(created on first start)" ;;
  url) PORT=$PORT node "$DIR/scripts/console-url.ts" ;;
esac
