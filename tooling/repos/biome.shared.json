{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.venv",
      "!!**/.git",
      "!!**/.codegraph",
      "!!**/.bundle",
      "!!**/vendor",
      "!!**/.impeccable",
      "!!**/test/tmp",
      "!!**/.scratch*",
      "!!**/.issue*",
      "!!**/arch-evidence",
      "!**/package-lock.json",
      "!**/*.min.js",
      "!**/*.svg",
      "!**/docs/**/*.json",
      "!**/docs/**/*.html"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noControlCharactersInRegex": "off", "noAssignInExpressions": "off" }
    }
  }
}
